# ---------------------------------------------------------------------------
# SpecToTC 환경 변수 (.env 로 복사해서 사용 / .env 는 커밋되지 않음)
# ---------------------------------------------------------------------------

# 로컬 서버 포트 (기본 3000)
PORT=3000

# [선택] Claude 보강 기능을 쓸 때만 필요. 없으면 규칙 엔진만 동작한다.
# Vercel 배포 시에는 Project Settings → Environment Variables 에 등록한다.
ANTHROPIC_API_KEY=

# [선택] 사용 모델 / 최대 출력 토큰
SPECTOTC_MODEL=claude-opus-5
SPECTOTC_MAX_TOKENS=32000

# [선택] 허용 기획서 최대 길이(문자)
SPECTOTC_MAX_SPEC=300000
