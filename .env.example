# ---------------------------------------------------------------------------
# SpecToTC 환경 변수 (.env 로 복사해서 사용 / .env 는 커밋되지 않음)
# ---------------------------------------------------------------------------

# 로컬 서버 포트 (기본 3000)
PORT=3000

# --- 접근 제어 (선택) ------------------------------------------------------
# 로그인은 선택 기능이다. 비워두면(기본) 인증 없이 열린다.
# 팀 공용 접속 비밀번호를 넣으면 로그인 화면이 활성화된다.
SPECTOTC_PASSWORD=

# true 로 두면 비밀번호가 없을 때 서비스를 503 으로 잠근다.
# (인증을 반드시 켜야 하는 환경에서만 사용)
SPECTOTC_REQUIRE_AUTH=

# 세션 쿠키 서명 키. 비우면 비밀번호에서 파생한다
# (비밀번호를 바꾸면 기존 세션이 모두 무효가 됨).
SPECTOTC_SESSION_SECRET=

# 세션 유효 시간(시간 단위, 기본 12)
SPECTOTC_SESSION_HOURS=12

# --- Claude 보강 (선택) ----------------------------------------------------
# 없으면 규칙 엔진만 동작한다.
ANTHROPIC_API_KEY=

# 사용 모델 / 최대 출력 토큰
SPECTOTC_MODEL=claude-opus-5
SPECTOTC_MAX_TOKENS=32000

# AI 기능 자체를 끄려면 false (키가 있어도 차단)
SPECTOTC_AI_ENABLED=

# 설정하면 useAI 요청에 X-AI-Token 헤더가 일치해야 허용된다
SPECTOTC_AI_TOKEN=

# --- 제한 ------------------------------------------------------------------
# 허용 기획서 최대 길이(문자)
SPECTOTC_MAX_SPEC=300000

# 업로드 최대 크기(바이트, 기본 25MB)
SPECTOTC_MAX_UPLOAD=

# 레이트리밋 비활성화 (테스트용, true 로만 설정)
SPECTOTC_DISABLE_RATELIMIT=

# 요청 로그 끄기 (true 로만 설정)
SPECTOTC_QUIET=

# --- 브라우저 실행 (선택, Vercel 에서는 동작하지 않음) ------------------------
# 1단계: 렌더링 분석. 페이지를 브라우저로 열어 JS 로 그려지는 요소까지 분석한다.
# 읽기만 하므로 대상 사이트 상태를 바꾸지 않는다. 먼저 `npm i --save-optional playwright-core`.
SPECTOTC_BROWSER=

# 2단계: 실행 검증. 폼에 실제로 값을 넣고 제출한다. 아래 3개가 모두 갖춰져야 동작한다.
# 임의의 공개 사이트에 가입·문의·로그인을 자동 제출하는 도구가 되지 않게 기본은 전부 잠겨 있다.
SPECTOTC_LIVE_SUBMIT=
# 검증 권한이 있는 도메인만 쉼표로. 비어 있으면 아무 곳도 제출할 수 없다. (하위 도메인 포함)
SPECTOTC_LIVE_ALLOW_HOSTS=
# POST 등 데이터를 바꿀 수 있는 폼까지 허용 (기본은 GET 폼만)
SPECTOTC_LIVE_ALLOW_POST=

# 브라우저 세부 설정
SPECTOTC_BROWSER_TIMEOUT=20000
SPECTOTC_BROWSER_SETTLE=1500
SPECTOTC_BROWSER_CHANNEL=chrome,msedge,chromium
