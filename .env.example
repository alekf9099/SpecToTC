# ---------------------------------------------------------------------------
# SpecToTC 환경 변수 (.env 로 복사해서 사용 / .env 는 커밋되지 않음)
# ---------------------------------------------------------------------------

# 로컬 서버 포트 (기본 3000)
PORT=3000

# --- 접근 제어 -------------------------------------------------------------
# 팀 공용 접속 비밀번호. 설정하면 로그인 화면이 활성화된다.
#  · 로컬에서 비워두면 인증 없이 열린다 (개발 편의).
#  · Vercel 등 배포 환경에서 비어 있으면 서비스 전체가 503 으로 잠긴다.
SPECTOTC_PASSWORD=

# 세션 쿠키 서명 키. 비우면 비밀번호에서 파생한다
# (비밀번호를 바꾸면 기존 세션이 모두 무효가 됨).
SPECTOTC_SESSION_SECRET=

# 세션 유효 시간(시간 단위, 기본 12)
SPECTOTC_SESSION_HOURS=12

# --- Claude 보강 (선택) ----------------------------------------------------
# 없으면 규칙 엔진만 동작한다.
ANTHROPIC_API_KEY=

# 사용 모델 / 최대 출력 토큰
SPECTOTC_MODEL=claude-opus-5
SPECTOTC_MAX_TOKENS=32000

# AI 기능 자체를 끄려면 false (키가 있어도 차단)
SPECTOTC_AI_ENABLED=

# 설정하면 useAI 요청에 X-AI-Token 헤더가 일치해야 허용된다
SPECTOTC_AI_TOKEN=

# --- 제한 ------------------------------------------------------------------
# 허용 기획서 최대 길이(문자)
SPECTOTC_MAX_SPEC=300000

# 업로드 최대 크기(바이트, 기본 25MB)
SPECTOTC_MAX_UPLOAD=

# 레이트리밋 비활성화 (테스트용, true 로만 설정)
SPECTOTC_DISABLE_RATELIMIT=

# 요청 로그 끄기 (true 로만 설정)
SPECTOTC_QUIET=
